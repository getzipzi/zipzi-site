# Only reviewed website sources may enter Git.
/*
!/.gitignore
!/.github/
!/README.md
!/LICENSE.md
!/NOTICE.md
!/package.json
!/package-lock.json
!/astro.config.ts
!/tsconfig.json
!/eslint.config.js
!/.prettierrc.mjs
!/.prettierignore
!/playwright.config.ts
!/src/
!/public/
!/vendor/
!/tooling/
!/tests/
!/docs/
**/node_modules/
**/.DS_Store
**/._*
**/.env
**/.env.*
**/*.pem
**/*.key

**/__pycache__/
**/*.py[cod]
