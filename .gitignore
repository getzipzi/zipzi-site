# Publish only reviewed website sources. Local deployment evidence stays local.
/*
!/.gitignore
!/README.md
!/package.json
!/src/
!/scripts/
/scripts/*
!/scripts/build.mjs
!/scripts/check.mjs
!/scripts/site.test.mjs
!/scripts/release.mjs
!/scripts/release.test.mjs
!/scripts/sync-release.mjs
!/scripts/lint.mjs
!/scripts/package.mjs
!/.github/
!/.github/workflows/
!/docs/
**/.DS_Store
**/._*
**/.env
**/.env.*
**/*.pem
**/*.key
**/node_modules/
