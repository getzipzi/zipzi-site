---
import { translate, language, type Locale } from '~/i18n';
const { locale = 'en' } = Astro.props as { locale?: Locale };
const t = translate(locale);

// Adapted from AstroWind Layout: no analytics, remote fonts, or client router.
import '~/assets/styles/tailwind.css';
import Metadata from '~/components/common/Metadata.astro';
import BrandArtwork from '~/components/common/BrandArtwork.astro';
import type { MetaData } from '~/types';
interface Props {
  metadata?: MetaData;
  locale?: Locale;
}
const { metadata = {} } = Astro.props;
---

<!doctype html>
<html lang={language(locale).lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <Metadata {...metadata} locale={locale} />
    <slot name="head" />
  </head>
  <body class="bg-page text-default antialiased">
    <BrandArtwork />
    <a class="skip-link" href="#main">{t('跳转到主要内容')}</a>
    <slot />
  </body>
</html>
