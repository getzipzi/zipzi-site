---
import { translate, language, type Locale } from '~/i18n';
const { locale = 'en' } = Astro.props as { locale?: Locale };
const t = translate(locale);
const home = language(locale).path;

import LanguageSwitcher from '~/components/common/LanguageSwitcher.astro';
import BrandIcon from '~/components/common/BrandIcon.astro';
import BrandWordmark from '~/components/common/BrandWordmark.astro';
import { repositoryUrl, releasesUrl } from '~/utils/product';
const links = [
  { href: home + '#editor', text: t('编辑器') },
  { href: home + '#developers', text: t('AI 协作') },
];
---

<header class="site-header" id="header">
  <div class="nav-shell">
    <a class="brand" href={home} aria-label={t('Zipzi 2D 首页')}><BrandIcon /><BrandWordmark /></a>
    <nav id="primary-navigation" aria-label={t('主导航')}>
      {links.map((link) => <a href={link.href}>{link.text}</a>)}
      <LanguageSwitcher locale={locale} />
      <a class="github-link" href={repositoryUrl} aria-label={t('Zipzi 2D GitHub 项目')}>GitHub</a>
    </nav>
    <a class="nav-release" href={releasesUrl}>{t('下载 Alpha')}<span aria-hidden="true">↗</span></a>
    <button
      class="menu-toggle"
      type="button"
      aria-controls="primary-navigation"
      aria-expanded="false"
      aria-label={t('打开导航')}
      data-open-label={t('打开导航')}
      data-close-label={t('关闭导航')}
      hidden
      ><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"
        ><path d="M4 8h16M4 16h16" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg
      ></button
    >
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('#header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('nav');
  if (header && toggle && nav) {
    const mobile = window.matchMedia('(max-width: 767px)');
    const close = (focus = false) => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', toggle.dataset.openLabel!);
      nav.hidden = mobile.matches;
      if (focus) toggle.focus();
    };
    const sync = () => {
      toggle.hidden = !mobile.matches;
      close();
    };
    header.dataset.enhanced = 'true';
    sync();
    mobile.addEventListener('change', sync);
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? toggle.dataset.closeLabel! : toggle.dataset.openLabel!);
      nav.hidden = !open;
      if (open) nav.querySelector('a')?.focus();
    });
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobile.matches && toggle.getAttribute('aria-expanded') === 'true') {
        event.preventDefault();
        close(true);
      }
    });
    nav.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest('a');
      if (!link) return;
      close();
      const url = new URL(link.href);
      if (url.pathname === window.location.pathname && url.hash) {
        const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
        if (target) {
          target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        }
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) close();
    });
  }
</script>
