---
import BrandIcon from '~/components/common/BrandIcon.astro';
import { repositoryUrl, releasesUrl } from '~/utils/product';
const links = [
  { href: '/#editor', text: '编辑器' },
  { href: '/#workflow', text: '工作流' },
  { href: '/#developers', text: '开发者' },
];
---

<header class="site-header" id="header">
  <div class="nav-shell">
    <div class="brand-group">
      <a class="brand" href="/" aria-label="Zipzi 2D 首页"
        ><BrandIcon /><span>Zipzi<span class="brand-suffix">2D</span></span></a
      >
      <a class="github-link" href={repositoryUrl} aria-label="Zipzi 2D GitHub 项目">
        <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" focusable="false" fill="currentColor">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
    </div>
    <nav id="primary-navigation" aria-label="主导航">{links.map((link) => <a href={link.href}>{link.text}</a>)}</nav>
    <a class="nav-release" href={releasesUrl}>下载 Alpha <span aria-hidden="true">↗</span></a>
    <button
      class="menu-toggle"
      type="button"
      aria-controls="primary-navigation"
      aria-expanded="false"
      aria-label="打开导航"
      hidden
      ><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"
        ><path d="M4 8h16M4 16h16" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg
      ></button
    >
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('#header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('nav');
  if (header && toggle && nav) {
    const mobile = window.matchMedia('(max-width: 767px)');
    const close = (focus = false) => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '打开导航');
      nav.hidden = mobile.matches;
      if (focus) toggle.focus();
    };
    const sync = () => {
      toggle.hidden = !mobile.matches;
      close();
    };
    header.dataset.enhanced = 'true';
    sync();
    mobile.addEventListener('change', sync);
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
      nav.hidden = !open;
      if (open) nav.querySelector('a')?.focus();
    });
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobile.matches && toggle.getAttribute('aria-expanded') === 'true') {
        event.preventDefault();
        close(true);
      }
    });
    nav.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest('a');
      if (!link) return;
      close();
      const url = new URL(link.href);
      if (url.pathname === window.location.pathname && url.hash) {
        const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
        if (target) {
          target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        }
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) close();
    });
  }
</script>
