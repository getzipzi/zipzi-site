---
import { translate, language, type Locale } from '~/i18n';
const { locale = 'zh-cn' } = Astro.props as { locale?: Locale };
const t = translate(locale);
const home = language(locale).path;

import { SITE } from 'astrowind:config';
import BrandIcon from '~/components/common/BrandIcon.astro';
import BrandWordmark from '~/components/common/BrandWordmark.astro';
---

<footer class="site-footer">
  <div class="container footer-main">
    <a href={home} class="footer-brand" aria-label={t('Zipzi 2D 首页')}
      ><BrandIcon size={64} /><BrandWordmark /><span class="footer-arrow" aria-hidden="true">↗</span></a
    ><p>{t('开源二维建模与动画。')}<br />{t('Live2D Cubism Editor 的开放替代。')}</p>
  </div>
  <div class="container footer-bottom">
    <span>© 2026 {SITE.name}</span><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer"
      >{t('浙ICP备2026015551号-2')}</a
    ><a href={home + '#main'}>{t('回到顶部 ↑')}</a>
  </div>
</footer>
