---
import { translate, type Locale } from '~/i18n';
const { locale = 'en' } = Astro.props as { locale?: Locale };
const t = translate(locale);

// Adapted from AstroWind Hero's content/action/image slots and static image loading.
import Button from '~/components/ui/Button.astro';
import { releasesUrl } from '~/utils/product';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="hero-positioning">
      <span class="status-dot" aria-hidden="true"></span>{t('Live2D Cubism Editor 的开源替代品')}
    </p>
    <h1 id="hero-title"><span class="hero-brand-name">Zipzi 2D</span><br /><span>{t('开源二维建模与动画。')}</span></h1>
    <p class="hero-description">
      {t('从一张画，到一个生动的角色。用网格、变形和关键帧赋予作品生命，用开放源码与 Python SDK 拓展你的创作方式。')}
    </p>
    <div class="hero-actions">
      <Button href={releasesUrl}>{t('下载 Alpha')}</Button>
      <a class="button button-secondary" href="#editor">{t('探索编辑器')}<span aria-hidden="true">↓</span></a>
    </div>
    <p class="hero-license">
      macOS & Windows <span aria-hidden="true">·</span> GPL Editor <span aria-hidden="true">·</span> MIT SDK
    </p>
  </div>
  <div class="showcase-stage"><slot name="image" /></div>
</section>
