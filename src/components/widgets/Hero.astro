---
// Adapted from AstroWind Hero's content/action/image slots and static image loading.
import Button from '~/components/ui/Button.astro';
import { releasesUrl } from '~/utils/product';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <div>
      <p class="eyebrow">2D MODELING &amp; ANIMATION</p><h1 id="hero-title">
        让二维创作，<br /><span>拥有更多可能。</span>
      </h1>
    </div>
    <div class="hero-description">
      <p class="hero-lead">从形态到动态，<br />把想法变成可控的表达。</p><p>
        Zipzi 2D 是二维建模与动画工具，探索 Live2D Cubism Editor 的替代工作流。用桌面编辑器创作，通过 Python 编程，与 AI
        Agent 协作。
      </p><div class="hero-actions">
        <Button href={releasesUrl}>下载 Alpha</Button><a class="text-link" href="#editor"
          >探索编辑器 <span aria-hidden="true">↓</span></a
        >
      </div>
    </div>
  </div>
  <slot name="image" />
  <div class="hero-caption">
    <p>为创作者提供直接的控制。<br class="mobile-only" />为开发者留下编程的空间。</p><span
      >Native editor <b>·</b> Rust core <b>·</b> Python SDK</span
    >
  </div>
</section>
