---
// Adapted from AstroWind Metadata: explicit crawl settings and local images only.
import { SEO } from 'astro-seo';
import { SITE, METADATA } from 'astrowind:config';
import { translate, language, languages, type Locale } from '~/i18n';
import type { MetaData } from '~/types';
export type Props = MetaData & { locale?: Locale };
const { locale = 'zh-cn' } = Astro.props;
const t = translate(locale);
const {
  title: pageTitle,
  description = t(METADATA.description!),
  robots = {},
  canonical = new URL(Astro.url.pathname, SITE.site).href,
} = Astro.props;
// Apply the shared template only to an explicit page title. The homepage uses
// the complete default verbatim so the site name is never appended twice.
const title = pageTitle ? (METADATA.title?.template ?? '%s').replace('%s', pageTitle) : METADATA.title?.default;
const ogImage = METADATA.openGraph?.images?.[0];
if (!ogImage || !SITE.site) throw new Error('Missing site origin or Open Graph image');
const image = new URL(ogImage.url, SITE.site).href;
---

<SEO
  title={title}
  description={description}
  canonical={canonical}
  noindex={robots.index === undefined ? METADATA.robots?.index !== true : !robots.index}
  nofollow={robots.follow === undefined ? METADATA.robots?.follow !== true : !robots.follow}
  openGraph={{
    basic: { title: title ?? SITE.name, type: 'website', image, url: canonical },
    optional: { description, locale: language(locale).og, siteName: SITE.name },
    image: {
      url: image,
      width: ogImage.width,
      height: ogImage.height,
      alt: t('Zipzi 2D README 中的猫模型与网格编辑界面'),
    },
  }}
  twitter={{ card: 'summary_large_image' }}
/>
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={t('Zipzi 2D README 中的猫模型与网格编辑界面')} />

{
  robots.index !== false &&
    languages.map((entry) => <link rel="alternate" hreflang={entry.lang} href={new URL(entry.path, SITE.site).href} />)
}
{robots.index !== false && <link rel="alternate" hreflang="x-default" href={new URL('/', SITE.site).href} />}
