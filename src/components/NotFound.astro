---
import { translate, language, type Locale } from '~/i18n';
const { locale = 'zh-cn' } = Astro.props as { locale?: Locale };
const t = translate(locale);
const home = language(locale).path;

import PageLayout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
---

<PageLayout
  locale={locale}
  metadata={{
    title: t('页面未找到'),
    description: t('此页面不存在。返回 Zipzi 2D 官网了解二维建模与动画工具。'),
    robots: { index: false, follow: false },
  }}
>
  <section class="container not-found">
    <p class="eyebrow">404 · PAGE NOT FOUND</p><h1>{t('这个页面')}<br /><span>{t('暂时没有形状。')}</span></h1><p>
      {t('链接可能有误，或页面已被移动。')}<br />{t('回到首页，继续了解 Zipzi 2D。')}
    </p><Button href={home}>{t('返回首页')}</Button>
  </section>
</PageLayout>
