{
  "name": "@getzipzi/zipzi-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "build": "astro build && node tooling/manifest.mjs",
    "test": "node --test tests/artifacts.test.mjs tests/release.test.mjs",
    "test:browser": "playwright test",
    "package": "node tooling/package.mjs",
    "audit:publication": "node tooling/audit-publication.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.3",
    "astro-seo": "1.2.0",
    "js-yaml": "4.3.2",
    "lodash.merge": "4.6.2",
    "sharp": "0.35.5",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/js-yaml": "4.0.9",
    "@types/lodash.merge": "4.6.9",
    "@typescript-eslint/parser": "8.66.0",
    "astro-eslint-parser": "3.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "fast-xml-parser": "5.11.2",
    "globals": "17.9.0",
    "parse5": "8.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
