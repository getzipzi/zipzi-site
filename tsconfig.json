{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": { "allowJs": true, "baseUrl": ".", "paths": { "~/*": ["src/*"] } },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "vendor/**/*",
    "astro.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "qa", "scripts", "release", "artifact"]
}
